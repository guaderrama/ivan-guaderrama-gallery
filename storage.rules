rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Token-based Role Helpers (supports roles[] array + legacy role string) ─────
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token.roles != null && role in request.auth.token.roles) ||
        request.auth.token.role == role
      );
    }

    function canWriteCatalog() {
      return hasRole('superadmin') || hasRole('editor_catalogo');
    }

    function canWriteEditions() {
      return hasRole('superadmin') || hasRole('editor_catalogo') || hasRole('editor_seriadas');
    }

    function isCourseManager() {
      return hasRole('superadmin') || hasRole('gestor_cursos');
    }

    // ─── Artwork images ───────────────────────────────────
    match /artworks/{artworkId}/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteCatalog();
    }

    // ─── Numbered Editions images ─────────────────────────
    match /numbered-editions/{seriesId}/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteEditions();
    }

    // ─── Albums images ───────────────────────────────────
    match /albums/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteCatalog();
    }

    // ─── Temporary uploads ────────────────────────────────
    match /temp/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── PDF Courses uploads ──────────────────────────────
    match /courses/{allPaths=**} {
      allow read: if true;
      allow write: if isCourseManager();
    }
  }
}

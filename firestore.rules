rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Artworks collection (Catálogo General)
    match /artworks/{artworkId} {
      // Allow queries (list) but filter results
      allow list: if true;
      // Only return specific docs if active or admin
      allow get: if resource.data.status == 'active' || isAdmin();
      // Only admins can create/update/delete
      allow create, update, delete: if isAdmin();

      // Numbered editions subcollection (old structure, keeping for compatibility)
      match /pieces/{pieceId} {
        allow list: if true;
        allow get: if resource.data.status == 'active' || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // Numbered Editions collection (new structure with subcollections)
    match /numbered-editions/{seriesId} {
      // Allow queries (list) but filter results
      allow list: if true;
      // Only return specific docs if active or admin
      allow get: if resource.data.seriesStatus == 'active' || isAdmin();
      // Only admins can create/update/delete series
      allow create, update, delete: if isAdmin();

      // Editions subcollection
      match /editions/{editionId} {
        // Allow queries (list) but filter results
        allow list: if true;
        allow get: if resource.data.status == 'active' || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // Mini Works collection
    match /mini-works/{workId} {
      // Allow queries (list) but filter results
      allow list: if true;
      // Only return specific docs if active or admin
      allow get: if resource.data.status == 'active' || isAdmin();
      // Only admins can create/update/delete
      allow create, update, delete: if isAdmin();
    }

    // Generated names collection (AI suggestions)
    match /generatedNames/{nameId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable once created
    }

    // PDF Courses collection
    match /pdf-courses/{courseId} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      // Only admins can create/update/delete
      allow create, update, delete: if isAdmin();
    }

    // Relationships collection (CRM)
    match /relationships/{relationshipId} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      // Only admins can create/update/delete
      allow create, update, delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Only admins can read all users
      allow read: if isAdmin();
      
      // Users can update their own profile (except role)
      allow update: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       request.resource.data.role == resource.data.role;
      
      // Only admins can create users or change roles
      allow create, delete: if isAdmin();
    }
  }
}
